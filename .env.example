# Plantilla de variables de entorno para el Generador COBOL IA
# Copia este archivo como .env y completa con tus valores reales

# API Key de OpenAI (opcional)
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# API Key de Google AI Studio (Gemini) - REQUERIDA PARA MIGRACIÓN
# Obtén tu clave en: https://aistudio.google.com/
GOOGLE_API_KEY="AIza..."

# API Key de Anthropic (opcional, para usar Claude)
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Configuración del modelo LLM (Gemini por defecto)
# En pruebas se usa un stub determinista (ver tests/conftest.py)
LLM_MODEL="gemini-1.5-flash"
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=8192
LLM_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# Configuración de logging
LOG_LEVEL="INFO"

# Configuración del validador (para futuras implementaciones)
MAINFRAME_HOST=""
MAINFRAME_PORT=""
MAINFRAME_USER=""
